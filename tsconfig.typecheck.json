{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "src/**/*",
    "scripts/**/*",
    "tests/**/*",
    "vite.config.js"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
